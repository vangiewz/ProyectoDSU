        "lineageTag": "1efae0ec-0687-5145-a3b0-6acef67c93bc",
        "measures": [
          {
            "name": "Total kg",
            "expression": "CALCULATE(SUM(bi_hechos_residuos[cantidad_base]), bi_hechos_residuos[magnitud] = \"PESO\")",
            "formatString": "#,0.00",
            "lineageTag": "fdf1ef91-6d3b-5405-b790-d5b8210e9367"
          },
          {
            "name": "Total L",
            "expression": "CALCULATE(SUM(bi_hechos_residuos[cantidad_base]), bi_hechos_residuos[magnitud] = \"VOLUMEN\")",
            "formatString": "#,0.00",
            "lineageTag": "6a049f0b-f474-5b99-a80b-5ea689e7bbd2"
          },
          {
            "name": "Registros",
            "expression": "COUNTROWS(bi_hechos_residuos)",
            "formatString": "#,0",
            "lineageTag": "4c7e0a28-8ef4-5d96-a4f8-5be5acee22bb"
          },
          {
            "name": "Puntos con datos",
            "expression": "DISTINCTCOUNT(bi_hechos_residuos[punto_codigo])",
            "formatString": "#,0",
            "lineageTag": "df0afe09-5010-5075-b710-2458f2070588"
          },
          {
            "name": "Promedio kg por punto",
            "expression": "DIVIDE([Total kg], [Puntos con datos])",
            "formatString": "#,0.00",
            "lineageTag": "6f18320f-cc81-54e5-a79f-6d201263dc8e"
          },
          {
            "name": "Total kg año anterior",
            "expression": "CALCULATE([Total kg], SAMEPERIODLASTYEAR(Calendario[Fecha]))",
            "formatString": "#,0.00",
            "lineageTag": "2768b4ff-c916-5fcc-b887-5b326c23c36c"
          },
          {
            "name": "Variación vs año anterior",
            "expression": "DIVIDE([Total kg] - [Total kg año anterior], [Total kg año anterior])",
            "formatString": "0.0%",
            "lineageTag": "4af646fe-6326-5fe5-bfb6-7271c2279c0a"
          },
          {
            "name": "Participación aprovechable",
            "expression": "DIVIDE(CALCULATE([Total kg], bi_hechos_residuos[aprovechable] = TRUE()), [Total kg])",
            "formatString": "0.0%",
            "lineageTag": "8719078c-18ee-5db0-bbfe-cf7a002d8798"
          }
        ],
        "partitions": [
          {
            "name": "bi_hechos_residuos",
            "mode": "import",
            "source": {
