            "sortByColumn": "Mes",
            "sourceColumn": "Nombre del mes",
            "summarizeBy": "none"
          },
          {
            "name": "Semestre",
            "dataType": "int64",
            "lineageTag": "ebcb95bf-a092-5069-92c2-27213df0b0e8",
            "sourceColumn": "Semestre",
            "summarizeBy": "none"
          },
          {
            "name": "Semana",
            "dataType": "int64",
            "lineageTag": "6ca0419f-e0b3-557b-8e82-e20c85314829",
            "sourceColumn": "Semana",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Año-Mes",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "FORMAT(Calendario[Fecha], \"yyyy-MM\")",
            "lineageTag": "e959c8f5-8a9b-5c96-b63b-fbf3eae6592c",
            "summarizeBy": "none"
          }
        ],
        "dataCategory": "Time",
        "lineageTag": "9a60da52-c2ad-52a9-972c-769fce402eb7",
        "partitions": [
          {
            "name": "Calendario",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Inicio = #date(2024, 1, 1),",
                "    Fin = Date.AddYears(Date.From(DateTime.LocalNow()), 1),",
                "    Fechas = List.Dates(Inicio, Duration.Days(Fin - Inicio) + 1, #duration(1, 0, 0, 0)),",
                "    Tabla = Table.FromList(Fechas, Splitter.SplitByNothing(), {\"Fecha\"}),",
                "    ConTipo = Table.TransformColumnTypes(Tabla, {{\"Fecha\", type datetime}}),",
                "    Anio = Table.AddColumn(ConTipo, \"Año\", each Date.Year([Fecha]), Int64.Type),",
                "    Mes = Table.AddColumn(Anio, \"Mes\", each Date.Month([Fecha]), Int64.Type),",
                "    NombreMes = Table.AddColumn(Mes, \"Nombre del mes\", each Date.ToText(Date.From([Fecha]), \"MMMM\", \"es-BO\"), type text),",
                "    Semestre = Table.AddColumn(NombreMes, \"Semestre\", each if Date.Month([Fecha]) <= 6 then 1 else 2, Int64.Type),",
                "    Semana = Table.AddColumn(Semestre, \"Semana\", each Date.WeekOfYear([Fecha], Day.Monday), Int64.Type)",
                "in",
                "    Semana"
              ],
              "type": "m"
            }
          }
        ]
      },
