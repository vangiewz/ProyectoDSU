# Plantilla para una configuración nueva. No sobrescribir el .env demo incluido en ProyectoDSU privado.
# No subir credenciales adicionales; ver ../../AGENTS.md antes de cambiar la visibilidad.
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# URL(s) del frontend, separadas por coma y sin barra final (ej. https://dsu.vercel.app)
CORS_ALLOWED_ORIGINS=
# Neon / PostgreSQL
DATABASE_URL=postgresql://usuario:password@host/neondb?sslmode=require&channel_binding=require
CONN_MAX_AGE=60
# Sesión JWT (RF3)
JWT_ACCESS_MINUTES=30
JWT_REFRESH_HOURS=10
# Área válida de coordenadas: lat_min,lon_min,lat_max,lon_max
CAMPUS_BBOX=-17.95,-63.35,-17.65,-63.05
LOG_LEVEL=INFO
# Producción (DEBUG=False): detrás de un proxy con TLS
SECURE_SSL_REDIRECT=True
# Carpeta de la copia local de los modelos entrenados (opcional)
# MODELOS_DIR=/var/lib/dsu/modelos
# Respaldo diario (RNF12): el mismo URL de Neon pero sin '-pooler' en el host
# RESPALDO_DATABASE_URL=postgresql://usuario:password@host-directo/neondb?sslmode=require
