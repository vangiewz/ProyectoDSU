    "codigo": " 27: def generar(request, horizonte: int, sector=None, punto=None) -> LotePrediccion:\n 28:     user = request.user\n 29:     maximo = ParametrosSistema.actual().horizonte_max_dias\n 30:     if not 1 <= horizonte <= maximo:\n 31:         raise ValidationError({\"horizonte\": f\"El horizonte debe estar entre 1 y {maximo} días.\"})\n 32:     modelo = entrenamiento.vigente()\n 33:     puntos = filtrar_por_sector(PuntoRecoleccion.objects.filter(is_active=True), user, \"sector\")\n 34:     for alcance in (sector, punto.sector if punto else None):\n 35:         if alcance:\n 36:             exigir_sector(user, alcance)\n 37:     if sector:\n 38:         puntos = puntos.filter(sector=sector)\n 39:     if punto:\n 40:         puntos = puntos.filter(pk=punto.pk)\n 41:     ids = list(puntos.values_list(\"pk\", flat=True))\n 42:     if not ids:\n 43:         raise ValidationError(\"No hay puntos activos en el alcance indicado.\")\n 44: \n 45:     # Paso 2: estado histórico de cada punto y variables temporales de las fechas futuras.\n 46:     hoy = timezone.localdate()\n 47:     estado = datos.estado_actual(hoy, ids)\n 48:     if estado.empty:\n 49:         raise ValidationError(\"Los puntos del alcance carecen de historial reciente suficiente para predecir.\")\n 50:     habituales = datos.dias_habituales(hoy, ids)\n 51:     fechas = pd.date_range(hoy + timedelta(days=1), periods=horizonte)\n 52:     filas = estado.merge(pd.DataFrame({\"fecha\": fechas}), how=\"cross\")\n 53:     filas = filas[\n 54:         [d in habituales.get(p, ()) for p, d in zip(filas[\"punto_id\"], filas[\"fecha\"].dt.dayofweek, strict=True)]\n 55:     ]\n 56:     if filas.empty:\n 57:         raise ValidationError(\"En el horizonte solicitado no hay días de recolección habitual para estos puntos.\")\n 58:     filas = datos.con_temporales(filas.reset_index(drop=True))\n 59: \n 60:     # Paso 3: inferencia con el modelo publicado.\n 61:     estimado = entrenamiento.cargar(modelo.pk).predict(filas[modelo.variables]).clip(min=0)\n 62:     margen = Decimal(str(round(modelo.rmse, 3)))\n 63:     filas[\"cantidad_kg\"] = estimado.round(3)\n 64:     filas[\"margen_kg\"] = float(margen)\n 65:     filas[\"fecha\"] = filas[\"fecha\"].dt.date\n 66:     omitidos = list(puntos.exclude(pk__in=set(estado[\"punto_id\"])).values_list(\"codigo\", flat=True))\n 67: \n 68:     # Paso 4: almacenamiento con la versión del modelo y entrega a las recomendaciones.\n 69:     with transaction.atomic():\n 70:         lote = LotePrediccion.objects.create(\n 71:             modelo=modelo,\n 72:             solicitado_por=user,\n 73:             desde=fechas[0].date(),\n 74:             hasta=fechas[-1].date(),\n 75:             sector=sector,\n 76:             punto=punto,\n 77:             puntos_omitidos=omitidos,\n 78:         )\n 79:         Prediccion.objects.bulk_create(\n 80:             (\n 81:                 Prediccion(\n 82:                     lote=lote,\n 83:                     punto_id=int(f.punto_id),\n 84:                     sector_id=int(f.sector_id),\n 85:                     tipo_residuo_id=int(f.tipo_residuo_id),\n 86:                     fecha=f.fecha,\n 87:                     cantidad_kg=Decimal(str(f.cantidad_kg)),\n 88:                     margen_kg=margen,\n 89:                 )\n 90:                 for f in filas.itertuples()\n 91:             ),\n 92:             batch_size=2000,\n 93:         )\n 94:         emitidas = recomendaciones.evaluar(\n 95:             lote, filas[[\"punto_id\", \"tipo_residuo_id\", \"fecha\", \"cantidad_kg\", \"margen_kg\"]]\n 96:         )\n 97:     registrar(\n 98:         request,\n 99:         AuditLog.Operacion.PROCESO,\n100:         lote,\n101:         detalle=f\"Predicción {lote.desde:%d/%m}–{lote.hasta:%d/%m} con el modelo v{modelo.version}: \"\n102:         f\"{len(ids) - len(omitidos)} punto(s), {len(emitidas)} recomendación(es)\",\n103:     )\n104:     return lote",
