    "codigo": " 39: def asignar(request, jornada, personal, vehiculos, responsable):\n 40:     \"\"\"RF13: asigna personal y vehículos validando superposición en el mismo turno.\"\"\"\n 41:     exigir_estado(jornada, E.PLANIFICADA, E.CONFIRMADA)\n 42:     if responsable is None:\n 43:         raise ValidationError({\"responsable\": \"Debe designar un responsable de la jornada.\"})\n 44:     if responsable not in personal:\n 45:         raise ValidationError({\"responsable\": \"El responsable debe formar parte del personal asignado.\"})\n 46:     no_operativos = [u.username for u in personal if not u.is_active or Rol.OPERATIVO not in u.roles]\n 47:     if no_operativos:\n 48:         raise ValidationError({\"personal\": f\"No son personal operativo activo: {', '.join(no_operativos)}.\"})\n 49:     fuera = [v.placa for v in vehiculos if v.estado == Vehiculo.Estado.FUERA_SERVICIO or not v.is_active]\n 50:     if fuera:\n 51:         raise ValidationError({\"vehiculos\": f\"Vehículos fuera de servicio: {', '.join(fuera)}.\"})\n 52: \n 53:     mismo_turno = Jornada.objects.filter(fecha=jornada.fecha, turno=jornada.turno).exclude(pk=jornada.pk)\n 54:     ocupados = set(mismo_turno.filter(personal__in=personal).values_list(\"personal__username\", flat=True))\n 55:     if ocupados:\n 56:         raise ValidationError(\n 57:             {\"personal\": f\"Ya asignados a otra jornada en este turno: {', '.join(sorted(ocupados))}.\"}\n 58:         )\n 59:     v_ocupados = set(mismo_turno.filter(vehiculos__in=vehiculos).values_list(\"vehiculos__placa\", flat=True))\n 60:     if v_ocupados:\n 61:         raise ValidationError({\"vehiculos\": f\"Ya asignados en este turno: {', '.join(sorted(v_ocupados))}.\"})\n 62: \n 63:     jornada.personal.set(personal)\n 64:     jornada.vehiculos.set(vehiculos)\n 65:     jornada.responsable = responsable\n 66:     jornada.save(update_fields=[\"responsable\"])\n 67:     registrar(\n 68:         request,\n 69:         Op.ACTUALIZAR,\n 70:         jornada,\n 71:         detalle=\"Asignación de personal y vehículos\",\n 72:         despues={\n 73:             \"personal\": [u.pk for u in personal],\n 74:             \"vehiculos\": [v.pk for v in vehiculos],\n 75:             \"responsable\": responsable.pk,\n 76:         },\n 77:     )",
